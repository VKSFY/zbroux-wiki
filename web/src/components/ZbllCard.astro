---
import { llSvg } from "../lib/ll-diagram.ts";
import type { ZbllCase } from "../lib/zbll.ts";
interface Props { c: ZbllCase }
const { c } = Astro.props;
const [best, ...alts] = c.algs;
---
<div class="case-row" id={c.id}>
  <Fragment set:html={llSvg(c.state, 78, `ZBLL case ${c.id}`)} />
  <div>
    <div class="cid">{c.id}</div>
    <div class="alg">{best.alg}</div>
    {alts.length > 0 && <div class="alts" set:html={alts.map((a) => a.alg).join("<br>")} />}
  </div>
  <div class="mv">{best.moves} moves</div>
</div>
