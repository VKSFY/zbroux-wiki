---
import Base from "../../layouts/Base.astro";
import { cases as eodfdb, set46 } from "../../lib/eodfdb";
import { zbll } from "../../lib/zbll.ts";

const ORDER = ["UF", "UR", "UB", "UL", "DF", "DB"] as const;
const in46 = new Set(set46().kept.map((c) => c.id));
const eod = eodfdb.filter((c) => c.algs[0]).map((c) => ({
  i: c.id, c: c.u_centre, a: c.algs,
  s: ORDER.map((n) => { const v = c.slots[n]; const ch = v.piece === "LL" ? "L" : v.piece === "DF" ? "F" : "B"; return v.flip ? ch.toLowerCase() : ch; }).join(""),
  f: in46.has(c.id) ? 2 : c.centres === "solved" ? 1 : 0,
}));
const zb = zbll.map((c) => ({ i: c.id, sh: c.shape, st: c.state, a: c.algs.map((x) => x.alg) }));
const SHAPES = [["T", "T"], ["U", "U"], ["L", "L"], ["H", "H"], ["Pi", "Pi"], ["S", "Sune"], ["AS", "Antisune"], ["PLL", "PLL"]];
---
<Base title="Trainer" description="Drill EODFDB and ZBLL cases: random setups, a timer, and your weakest cases first." crumbs={[{ href: "/tools/", label: "Tools" }]}>
  <h1>Trainer</h1>
  <p class="lede">Pick a set. Do the setup moves on a solved cube, then press <kbd>Space</kbd> (or tap the timer) to start, solve the case, and press it again to stop. Your times are saved in this browser only.</p>

  <section class="opts no-print">
    <div class="row">
      <span class="lbl">Set</span>
      <div class="choices" id="sets">
        <button type="button" data-v="eod46">EODFDB: 46-case set (62 with mirrors)</button>
        <button type="button" data-v="eod248">EODFDB: centres aligned (248)</button>
        <button type="button" data-v="eod992">EODFDB: all 992</button>
        <button type="button" data-v="zbll">ZBLL</button>
      </div>
    </div>
    <div class="row" id="shapesRow" hidden>
      <span class="lbl">ZBLL sets</span>
      <div class="checks">
        {SHAPES.map(([k, name]) => <label><input type="checkbox" data-shape={k} checked={k === "T"} /> {name}</label>)}
      </div>
    </div>
    <div class="row">
      <span class="lbl">Order</span>
      <div class="choices" id="order">
        <button type="button" data-v="weak">Weakest first</button>
        <button type="button" data-v="random">Random</button>
      </div>
      <label class="pic"><input type="checkbox" id="showPic" /> Show the case picture before solving</label>
    </div>
  </section>

  <section class="drill">
    <div class="setup">
      <span class="lbl">Setup</span>
      <div class="alg big" id="setup"></div>
      <span class="muted small" id="pool"></span>
    </div>
    <button type="button" class="timer" id="timer" aria-live="polite">0.00</button>
    <div class="result" id="result" hidden>
      <div id="pic"></div>
      <div>
        <div class="cid" id="rcase"></div>
        <div class="alg" id="ralg"></div>
        <div class="alts" id="ralts"></div>
        <div class="muted small" id="rstats"></div>
      </div>
    </div>
    <div class="actions no-print">
      <button type="button" class="btn primary" id="next">Next case</button>
      <button type="button" class="btn" id="mistake" disabled>That was a mistake</button>
      <button type="button" class="btn" id="undo" disabled>Delete last time</button>
    </div>
  </section>

  <section class="stats">
    <div class="shead">
      <h2>Your times</h2>
      <button type="button" class="btn" id="reset">Reset times for this set</button>
    </div>
    <p class="muted small" id="summary"></p>
    <table class="table" id="table"><thead><tr><th>Case</th><th>Solves</th><th>Average</th><th>Best</th><th>Mistakes</th></tr></thead><tbody></tbody></table>
  </section>
</Base>

<script type="application/json" id="trainer-data" set:html={JSON.stringify({ eod, zb })} />

<script>
  import { lseSvg, type LseSlots } from "../../lib/lse-diagram.ts";
  import { llSvg } from "../../lib/ll-diagram.ts";
  import { parse, invert } from "../../lib/cube.ts";

  type Eod = { i: string; c: string; a: string[]; s: string; f: number };
  type Zb = { i: string; sh: string; st: string; a: string[] };
  type Case = { id: string; algs: string[]; pic: () => string };
  type Rec = { t: number[]; m: number };

  const DATA = JSON.parse(document.getElementById("trainer-data")!.textContent!) as { eod: Eod[]; zb: Zb[] };
  const $ = (id: string) => document.getElementById(id)!;
  const NAMES = ["UF", "UR", "UB", "UL", "DF", "DB"] as const;
  const slotsOf = (s: string) => Object.fromEntries(NAMES.map((n, j) => {
    const ch = s[j]; const P = ch.toUpperCase();
    return [n, { piece: P === "L" ? "LL" : P === "F" ? "DF" : "DB", flip: ch !== P }];
  })) as LseSlots;

  const load = <T,>(k: string, d: T): T => { try { const v = localStorage.getItem(k); return v ? JSON.parse(v) : d; } catch { return d; } };
  const save = (k: string, v: unknown) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} };

  const prefs = load("trainer-prefs", { set: "eod46", order: "weak", shapes: ["T"], pic: false });
  let current: Case | null = null;
  let last: Case | null = null;
  let lastTime = 0;
  let running = false, start = 0, raf = 0;

  function pool(): Case[] {
    if (prefs.set === "zbll") {
      return DATA.zb.filter((c) => prefs.shapes.includes(c.sh)).map((c) => ({ id: c.i, algs: c.a, pic: () => llSvg(c.st, 110, "ZBLL " + c.i) }));
    }
    const min = prefs.set === "eod46" ? 2 : prefs.set === "eod248" ? 1 : 0;
    return DATA.eod.filter((c) => c.f >= min).map((c) => ({ id: c.i, algs: c.a, pic: () => lseSvg(slotsOf(c.s), c.c, 96, "Case " + c.i) }));
  }
  const storeKey = () => "trainer-times-" + (prefs.set === "zbll" ? "zbll" : "eodfdb");
  let times: Record<string, Rec> = load(storeKey(), {});

  const avg = (r?: Rec) => (r && r.t.length ? r.t.reduce((a, b) => a + b, 0) / r.t.length : 0);
  const AUF = ["", "U", "U2", "U'"];
  function simplify(seq: string[]) {
    const out: [string, number][] = [];
    const q: Record<string, number> = { "": 1, "2": 2, "'": 3 };
    for (const m of seq) {
      const f = m[0], n = q[m.slice(1)];
      if (out.length && out[out.length - 1][0] === f) {
        const t = (out[out.length - 1][1] + n) % 4; out.pop(); if (t) out.push([f, t]);
      } else out.push([f, n]);
    }
    return out.map(([f, n]) => f + ["", "", "2", "'"][n]).join(" ");
  }
  function setupFor(c: Case) {
    const alg = c.algs[Math.floor(Math.random() * c.algs.length)];
    const pre = prefs.set === "zbll" ? AUF[Math.floor(Math.random() * 4)] : "";
    const post = AUF[Math.floor(Math.random() * 4)];
    return simplify([...parse(pre), ...invert(parse(alg)), ...parse(post)]);
  }
  function pick(list: Case[]) {
    const options = list.length > 1 && last ? list.filter((c) => c.id !== last!.id) : list;
    if (prefs.order === "random") return options[Math.floor(Math.random() * options.length)];
    const seen = options.filter((c) => times[c.id]?.t.length);
    const overall = seen.length ? seen.reduce((a, c) => a + avg(times[c.id]), 0) / seen.length : 1;
    const w = options.map((c) => {
      const r = times[c.id];
      if (!r || !r.t.length) return 4;
      return Math.pow(avg(r) / overall, 2) + 0.6 * r.m / r.t.length;
    });
    let x = Math.random() * w.reduce((a, b) => a + b, 0);
    for (let i = 0; i < options.length; i++) { x -= w[i]; if (x <= 0) return options[i]; }
    return options[options.length - 1];
  }

  function render() {
    document.querySelectorAll<HTMLButtonElement>("#sets button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.v === prefs.set)));
    document.querySelectorAll<HTMLButtonElement>("#order button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.v === prefs.order)));
    ($("showPic") as HTMLInputElement).checked = prefs.pic;
    $("shapesRow").hidden = prefs.set !== "zbll";
    document.querySelectorAll<HTMLInputElement>("[data-shape]").forEach((el) => (el.checked = prefs.shapes.includes(el.dataset.shape!)));
    renderStats();
  }
  function renderStats() {
    const list = pool();
    const ids = new Set(list.map((c) => c.id));
    const rows = Object.entries(times).filter(([id, r]) => ids.has(id) && r.t.length).sort((a, b) => avg(b[1]) - avg(a[1]));
    const all = rows.flatMap(([, r]) => r.t);
    $("summary").textContent = rows.length
      ? `${rows.length} of ${list.length} cases practised, ${all.length} solves, overall average ${(all.reduce((a, b) => a + b, 0) / all.length).toFixed(2)} s. Slowest first.`
      : `${list.length} cases in this set. No times yet.`;
    ($("table").querySelector("tbody") as HTMLElement).innerHTML = rows.map(([id, r]) =>
      `<tr><td>${id}</td><td>${r.t.length}</td><td>${avg(r).toFixed(2)}</td><td>${Math.min(...r.t).toFixed(2)}</td><td>${r.m}</td></tr>`).join("");
  }
  function next() {
    const list = pool();
    $("result").hidden = true;
    ($("mistake") as HTMLButtonElement).disabled = true;
    if (!list.length) { $("setup").textContent = "Pick at least one ZBLL set."; $("pool").textContent = ""; current = null; return; }
    current = pick(list);
    $("setup").textContent = setupFor(current);
    $("pool").textContent = `${list.length} cases in this set`;
    $("timer").textContent = "0.00";
    if (prefs.pic) { $("pic").innerHTML = current.pic(); $("result").hidden = false; $("rcase").textContent = ""; $("ralg").textContent = ""; $("ralts").textContent = ""; $("rstats").textContent = ""; }
  }
  function tick() { $("timer").textContent = ((performance.now() - start) / 1000).toFixed(2); raf = requestAnimationFrame(tick); }
  function toggle() {
    if (!current) return;
    if (!running) {
      running = true; start = performance.now(); $("timer").classList.add("on"); tick();
      if (!prefs.pic) $("result").hidden = true;
      return;
    }
    running = false; cancelAnimationFrame(raf); $("timer").classList.remove("on");
    const t = (performance.now() - start) / 1000;
    $("timer").textContent = t.toFixed(2);
    const r = times[current.id] ?? { t: [], m: 0 };
    r.t.push(Math.round(t * 100) / 100);
    times[current.id] = r; save(storeKey(), times);
    last = current; lastTime = t;
    $("pic").innerHTML = current.pic();
    $("rcase").textContent = current.id;
    $("ralg").textContent = current.algs[0];
    $("ralts").innerHTML = current.algs.slice(1).join("<br>");
    $("rstats").textContent = `This case: ${r.t.length} solves, average ${avg(r).toFixed(2)} s, best ${Math.min(...r.t).toFixed(2)} s.`;
    $("result").hidden = false;
    ($("mistake") as HTMLButtonElement).disabled = false;
    ($("undo") as HTMLButtonElement).disabled = false;
    renderStats();
  }

  $("sets").addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button"); if (!b) return;
    prefs.set = b.dataset.v!; save("trainer-prefs", prefs); times = load(storeKey(), {}); last = null; render(); next();
  });
  $("order").addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button"); if (!b) return;
    prefs.order = b.dataset.v!; save("trainer-prefs", prefs); render();
  });
  document.querySelectorAll<HTMLInputElement>("[data-shape]").forEach((el) => el.addEventListener("change", () => {
    prefs.shapes = [...document.querySelectorAll<HTMLInputElement>("[data-shape]")].filter((x) => x.checked).map((x) => x.dataset.shape!);
    save("trainer-prefs", prefs); renderStats(); next();
  }));
  $("showPic").addEventListener("change", (e) => { prefs.pic = (e.target as HTMLInputElement).checked; save("trainer-prefs", prefs); next(); });
  $("timer").addEventListener("click", toggle);
  $("next").addEventListener("click", () => { if (!running) next(); });
  $("mistake").addEventListener("click", () => {
    if (!last) return;
    const r = times[last.id]; if (r) { r.m += 1; save(storeKey(), times); }
    ($("mistake") as HTMLButtonElement).disabled = true; renderStats();
  });
  $("undo").addEventListener("click", () => {
    if (!last) return;
    const r = times[last.id];
    if (r && r.t.length) { const i = r.t.lastIndexOf(Math.round(lastTime * 100) / 100); if (i >= 0) r.t.splice(i, 1); if (!r.t.length) delete times[last.id]; save(storeKey(), times); }
    ($("undo") as HTMLButtonElement).disabled = true; ($("mistake") as HTMLButtonElement).disabled = true; renderStats();
  });
  $("reset").addEventListener("click", () => {
    if (!confirm("Delete all your times for this set? This can't be undone.")) return;
    times = {}; save(storeKey(), times); renderStats();
  });
  document.addEventListener("keydown", (e) => {
    const tgt = e.target instanceof Element ? e.target : document.body;
    if (e.code !== "Space" || tgt.closest("input, textarea, select") || (tgt.closest("button") && tgt.id !== "timer")) return;
    e.preventDefault();
    if (e.repeat) return;
    if (!running && $("result").hidden === false && current && last === current) { next(); return; }
    toggle();
  });

  render();
  next();
</script>

<style>
  .opts{display:grid;gap:12px;margin:8px 0 22px}
  .row{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px}
  .lbl{font-size:.82rem;font-weight:650;color:var(--mute);min-width:70px}
  .checks{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:.92rem}
  .pic{font-size:.9rem;color:var(--ink-2)}
  .drill{border:1px solid var(--line);border-radius:10px;padding:18px 20px;display:grid;gap:14px;max-width:var(--content)}
  .setup{display:grid;gap:4px}
  .big{font-size:1.25rem;line-height:1.5}
  .timer{font:700 3.2rem/1 var(--mono);text-align:center;padding:22px 0;border:1px dashed var(--line);border-radius:10px;background:var(--surface);color:var(--ink);cursor:pointer;user-select:none;-webkit-user-select:none;touch-action:manipulation}
  .timer.on{color:var(--accent);border-color:var(--accent)}
  .result{display:flex;gap:16px;align-items:center}
  .result :global(svg){color:var(--ink);flex:0 0 auto}
  .cid{font-weight:700}
  .alts{font:.82rem/1.5 var(--mono);color:var(--mute)}
  .actions{display:flex;flex-wrap:wrap;gap:8px}
  .stats{margin-top:30px;max-width:var(--content)}
  .shead{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:10px}
  .shead h2{font-size:1.2rem;margin:0}
  .table td,.table th{white-space:nowrap}
  kbd{border:1px solid var(--line);border-bottom-width:2px;border-radius:4px;padding:0 5px;font-size:.85em;background:var(--surface)}
</style>
