---
import Base from "../../../../layouts/Base.astro";
import EsCaseCard from "../../../../components/EsCaseCard.astro";
import EsLegend from "../../../../components/EsLegend.astro";
import { stripeCases, STRIPE_VARIANTS, STRIPE_GROUPS, stripeGroup, stats } from "../../../../lib/eostripe.ts";

export function getStaticPaths() {
  return STRIPE_VARIANTS.map((v) => ({ params: { variant: v.slug }, props: { variant: v } }));
}
const TOP: Record<string, { label: string; col: string }> = {
  solved: { label: "your top color", col: "yel" }, "off-M": { label: "green", col: "grn" },
  "off-M'": { label: "blue", col: "blu" }, "off-M2": { label: "your bottom color", col: "wht" },
};
const { variant } = Astro.props;
const list = stripeCases.filter((c) => c.centers === variant.centers);
const s = stats(list);
const base = "/algs/eostripe/stripe/";
---
<Base title="EOStripe: placing DF and DB" description={`LEOR EOStripe cases where all edges are oriented and DF, DB and the centers are left. ${s.n} cases with the top center showing ${TOP[variant.centers].label}.`} crumbs={[{ href: "/methods/leor/", label: "LEOR" }, { href: "/methods/leor/eostripe/", label: "EOStripe" }]}>
  <h1>EOStripe: placing DF and DB</h1>
  <p class="lede">Every edge is already oriented. What's left is putting the two bottom edges (DF and DB) in place and aligning the centers. Every solution keeps the edges oriented and is the shortest possible in R, r, M and U.</p>
  <div class="no-print">
    <p class="pick">Which color is on your top center?</p>
    <div class="choices">
      {STRIPE_VARIANTS.map((v) => (
        <a class="choice" href={v.slug ? `${base}${v.slug}/` : base} aria-pressed={v.centers === variant.centers ? "true" : "false"}>
          <i style={`background:var(--${TOP[v.centers].col})`}></i>{TOP[v.centers].label[0].toUpperCase() + TOP[v.centers].label.slice(1)}
        </a>
      ))}
    </div>
    <p><button class="btn" type="button" id="print">Print / save as PDF</button> <a class="btn" href="/algs/eostripe/eo/">Cases for orienting edges</a></p>
  </div>
  <EsLegend />
  {STRIPE_GROUPS.map((g) => {
    const gl = list.filter((c) => stripeGroup(c) === g.key);
    if (!gl.length) return null;
    return (
      <section>
        <h2>{g.label}</h2>
        <p class="small muted">{g.blurb} {gl.length} cases.</p>
        <div class="cases">{gl.map((c) => <EsCaseCard c={c} />)}</div>
      </section>
    );
  })}
  <p class="small muted">{s.n} cases, average {s.avg.toFixed(1)} moves. Counted up to turning the top layer first; when several shortest solutions exist, the one with the fewest M moves comes first.</p>
</Base>
<script>document.getElementById("print")?.addEventListener("click", () => window.print());</script>
<style>
  .pick{font-weight:600;margin:0 0 6px}
  .choices i{display:inline-block;width:14px;height:14px;border-radius:3px;border:1px solid #0007}
  .choices a{color:var(--ink)}
  .choices a:hover{text-decoration:none}
  .choices + p{margin-top:14px}
  h2{font-size:1.2rem;margin:28px 0 2px}
</style>
