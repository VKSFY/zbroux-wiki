---
import { lseSvg } from "../../../lib/lse-diagram.ts";
import { set46 } from "../../../lib/eodfdb";
import { SITE_NAME } from "../../../lib/site";
import "../../../styles/global.css";

const { list } = set46();
const groups = [
  { title: "Top centre: your top colour", items: list.filter((c) => c.centres === "solved") },
  { title: "Top centre: your bottom colour", items: list.filter((c) => c.centres === "off-M2") },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>EODFDB 46-case cheat sheet · {SITE_NAME}</title>
  <meta name="description" content="One printable page with all 46 EODFDB cases and algorithms." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline>try{if(localStorage.getItem("topColour")==="white")document.documentElement.dataset.top="white"}catch(e){}</script>
</head>
<body>
  <header class="no-print">
    <a href="/algs/eodfdb/46/">← The 46-case set</a>
    <button class="btn primary" type="button" onclick="window.print()">Print</button>
  </header>
  <main>
    <h1>EODFDB: the 46-case set</h1>
    <p class="sub">Both bottom edges on top and opposite. Moves in STM. For a mirror case, use the second line (U and U' swapped). From {SITE_NAME}.</p>
    {groups.map((g) => (
      <section>
        <h2>{g.title}</h2>
        <div class="grid">
          {g.items.map((c) => (
            <div class="cell">
              <Fragment set:html={lseSvg(c.slots as any, c.u_centre, 44, c.id)} />
              <div class="txt">
                <b>{c.id}</b>
                <span class="alg">{c.algs[0]}</span>
                {c.mirror_of !== c.id && <span class="mirror">{c.mirror_of}: {c.mirror_alg}</span>}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </main>
</body>
</html>
<style>
  body{margin:0;background:var(--bg);color:var(--ink);font:13px/1.35 var(--font)}
  header{display:flex;justify-content:space-between;align-items:center;max-width:1100px;margin:0 auto;padding:12px 16px}
  main{max-width:1100px;margin:0 auto;padding:0 16px 30px}
  h1{font-size:1.25rem;margin:4px 0 2px}
  .sub{margin:0 0 6px;color:var(--mute);font-size:.8rem}
  h2{font-size:.85rem;margin:10px 0 4px;color:var(--ink-2)}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:3px}
  .cell{display:flex;gap:6px;align-items:center;border:1px solid var(--line);border-radius:4px;padding:3px 5px;break-inside:avoid}
  .cell :global(svg){flex:0 0 auto;color:var(--ink)}
  .txt{display:flex;flex-direction:column;min-width:0}
  .txt b{font-size:.75rem}
  .alg{font:600 .78rem/1.3 var(--mono)}
  .mirror{font:.68rem/1.3 var(--mono);color:var(--mute)}
  @page{size:A4;margin:8mm}
  @media print{
    body{font-size:10px}
    main{max-width:none;padding:0}
    .grid{grid-template-columns:repeat(4,1fr);gap:2px}
    .cell{padding:2px 3px}
    .cell :global(svg){width:34px;height:auto}
    .alg{font-size:7.6pt}
    .mirror{font-size:6.4pt}
    h1{font-size:12pt}
    h2{font-size:8.5pt;margin:4px 0 2px}
  }
</style>
