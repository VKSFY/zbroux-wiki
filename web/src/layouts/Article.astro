---
import Base from "./Base.astro";
import PrevNext from "../components/PrevNext.astro";
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} description={frontmatter.description} crumbs={frontmatter.crumbs ?? []}>
  <article class="prose">
    <h1>{frontmatter.title}</h1>
    {frontmatter.lede && <p class="lede">{frontmatter.lede}</p>}
    <slot />
  </article>
  <PrevNext />
</Base>
